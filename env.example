# Copy these into Railway > your service > Variables (do NOT commit real values)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password
SESSION_SECRET=any-long-random-text-at-least-32-characters
# Optional
# DATA_DIR=/data                       (Railway sets RAILWAY_VOLUME_MOUNT_PATH automatically when a volume is attached)
# STATS_TZ=Europe/Istanbul             (time zone used for daily charts and busiest hours)
# ALLOWED_ORIGINS=https://yourname.github.io   (only if the site stays on GitHub Pages and only the API runs on Railway)
